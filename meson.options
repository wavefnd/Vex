option(
    'release_targets',
    type: 'array',
    value: [],
    description: 'Release triples; empty selects the rustc host',
)
option(
    'allow_unverified',
    type: 'boolean',
    value: false,
    description: 'Development package only: allow a missing execution verifier',
)
option(
    'cargo',
    type: 'array',
    value: ['cargo'],
    description: 'Cargo executable and optional leading arguments; never interpreted by a shell',
)
option(
    'test_target',
    type: 'string',
    value: '',
    description: 'Cargo test triple, for host-compiled QEMU acceptance',
)
option(
    'acceptance_platform',
    type: 'string',
    value: '',
    description: 'Platform ID from platforms.json for full compiler/ABI acceptance',
)
option(
    'contract_wavec',
    type: 'string',
    value: '',
    description: 'Explicit prepared compiler for supplemental external-build contract acceptance',
)
option(
    'contract_std',
    type: 'string',
    value: '',
    description: 'Matching prepared std root for external-build contract acceptance',
)
