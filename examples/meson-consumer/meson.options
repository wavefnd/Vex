option(
    'vex',
    type: 'string',
    value: 'vex',
    description: 'Prepared Vex executable on the build machine',
)
option(
    'wave_target',
    type: 'string',
    value: '',
    description: 'Exact Wave output target; empty selects compiler host',
)
option('wave_profile', type: 'string', value: 'dev')
option('wave_features', type: 'array', value: [])
option(
    'adapter',
    type: 'string',
    value: '',
    description: 'Optional absolute path to tools/meson_consumer.py',
)
